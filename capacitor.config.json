{
  "appId": "mx.pixelium.aura",
  "appName": "Aura",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#EEF0FA"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1400,
      "launchAutoHide": true,
      "backgroundColor": "#EEF0FA",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#EEF0FA"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "FirebaseAppCheck": {
      "debug": false
    }
  }
}
