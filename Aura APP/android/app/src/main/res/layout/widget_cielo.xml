<?xml version="1.0" encoding="utf-8"?>
<!-- AURA — Widget "Tu cielo".
     Sin ConstraintLayout: RemoteViews solo admite unos cuantos tipos
     de vista, y ese no es uno. LinearLayout y FrameLayout sí. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cielo_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_fondo">

    <ImageView
        android:id="@+id/cielo_mapa"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_cielo_desc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1.25"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/cielo_dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/aura_morado"
            android:text="—" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/aura_texto_tenue"
            android:text="@string/widget_dias" />

        <TextView
            android:id="@+id/cielo_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/aura_texto"
            android:text="@string/widget_cielo_titulo" />

        <TextView
            android:id="@+id/cielo_progreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/aura_texto_tenue"
            android:text="" />
    </LinearLayout>
</LinearLayout>
