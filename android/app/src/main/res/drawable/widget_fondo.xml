<?xml version="1.0" encoding="utf-8"?>
<!-- El vidrio del widget. No puede ser translúcido de verdad: un
     widget no desenfoca lo que tiene detrás, así que es un color
     sólido claro con el mismo borde luminoso de las tarjetas. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@color/aura_vidrio" />
    <stroke android:width="1dp" android:color="@color/aura_borde" />
</shape>
